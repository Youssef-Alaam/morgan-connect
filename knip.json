{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["gitleaks"],
  "workspaces": {
    ".": {
      "entry": ["src/main.ts", "src/evals/cli.ts", "src/*/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "web": {
      "entry": ["e2e/*.spec.ts", "e2e-stack/*.spec.ts"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "e2e-stack/**/*.ts"]
    }
  }
}
