{
  "name": "morgan-connect",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted, open-source AI agent for a small team or family.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "depcruise": "depcruise src web test --config .dependency-cruiser.cjs",
    "knip": "knip",
    "licences": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;CC0-1.0;Unlicense;BlueOak-1.0.0\"",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:perf": "vitest run --project perf",
    "secrets": "gitleaks git --no-banner --redact",
    "commits": "commitlint --from origin/main",
    "audit": "npm audit --audit-level=high",
    "check": "npm run commits && npm run secrets && npm run format && npm run lint && npm run typecheck && npm run depcruise && npm run knip && npm run licences && npm run licences:web && npm run audit && npm run test:unit",
    "evals": "tsc -p tsconfig.evals.json && node dist-evals/evals/cli.js",
    "build:web": "npm run build -w web",
    "licences:web": "node scripts/check-web-licences.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/node": "^26.6.10",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.15.0",
    "eslint-plugin-i18next": "^6.1.5",
    "knip": "^6.48.0",
    "lefthook": "^2.2.3",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@hono/node-server": "^2.1.11",
    "grammy": "^1.48.0",
    "hono": "^4.13.22",
    "kysely": "^0.29.9",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.39.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "workspaces": [
    "web"
  ]
}
