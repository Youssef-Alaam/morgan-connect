# The app's Postgres connection, as the app role. That role can only INSERT and SELECT on audit_log.
# Compose replaces it with one that points at its own db service.
DATABASE_URL=postgres://morgan_app:change-me-too@localhost:5432/morgan
# The owner role that runs migrations and creates the app role from DATABASE_URL at boot. If you
# leave it unset, one role does both and the audit log is guarded by triggers only (dev only).
# The app refuses to start when the DATABASE_URL role is a superuser or has BYPASSRLS, because
# row-level security would not apply; the owner role must be a superuser or have BYPASSRLS.
MIGRATION_DATABASE_URL=postgres://morgan:change-me@localhost:5432/morgan
# Upgrading a compose install: add APP_DB_PASSWORD to your .env before you start it, or compose stops.
# Password of the app role under compose. Change it before you keep any real data.
APP_DB_PASSWORD=change-me-too
# Password for the Postgres that compose starts. Change it before you keep any real data.
POSTGRES_PASSWORD=change-me
# Port the app listens on (inside compose it is always 3000).
PORT=3000
# One of: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
# Telegram bot token from @BotFather. Optional until the Telegram channel lands.
TELEGRAM_BOT_TOKEN=replace-me
# WARNING: whatever host you set here receives the bot token. Leave it unset for Telegram itself.
# TELEGRAM_API_ROOT=https://your-own-bot-api-server.example.com
# Anthropic API key. Without it the bot only echoes messages. Never logged.
ANTHROPIC_API_KEY=replace-me
# The Claude model that answers. Any id in Pi's Anthropic catalog; defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to true to add a harmless demo.gated tool that asks for your approval, to try the buttons.
# DEMO_TOOLS=true
# Save notes to your vault inbox (needs your approval each time). Set both, or neither.
# VAULT_REMOTE_URL=https://github.com/you/your-vault.git
# VAULT_TOKEN=a fine-grained token with write access to that one repository
# VAULT_BRANCH=main
# Which engine answers: pi (default, uses ANTHROPIC_API_KEY) or http (an engine you host yourself).
# ENGINE=http
# Where that engine listens. Under compose the host machine is host.docker.internal.
# It receives ENGINE_TOKEN, so use https unless it runs on this machine.
# ENGINE_URL=http://host.docker.internal:8787
# Shared secret sent to the engine in the x-engine-token header. Use a long random value. Never logged.
# ENGINE_TOKEN=replace-me
# The HTTP engine gets only the text of each turn (POST <url>/turn, plus /abort and /end). It keeps
# its own session per conversation, so history and tools are not sent in v1.

# The built web app (web/dist) to serve at / with the API. The Docker image sets it; unset: only the API answers.
# WEB_DIR=web/dist
