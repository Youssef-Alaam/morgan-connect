# Postgres connection string. Compose replaces it with one that points at its own db service.
DATABASE_URL=postgres://morgan:change-me@localhost:5432/morgan
# Password for the Postgres that compose starts. Change it before you keep any real data.
POSTGRES_PASSWORD=change-me
# Port the app listens on (inside compose it is always 3000).
PORT=3000
# One of: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
# Telegram bot token from @BotFather. Optional until the Telegram channel lands.
TELEGRAM_BOT_TOKEN=replace-me
# Anthropic API key. Optional until a real model is wired in.
ANTHROPIC_API_KEY=replace-me
